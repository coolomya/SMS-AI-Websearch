# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions: Copy this file to a new file named '.env' in the same directory
# and populate the values below with your specific operational credentials.
# ==============================================================================

# --- Application Configuration ---
APP_TITLE="Async LangGraph Search Assistant"
SEARXNG_URL="http://localhost:8080"
MAX_RETRY_COUNT=3

# --- Primary Cloud LLM Layer ---
# Required for primary pipeline generation and fast evaluation passes.
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# --- Resilient Fallback Local LLM Layer ---
# Used for system-wide failovers if cloud providers suffer disruptions.
OLLAMA_MODEL="llama3.2:3b"
